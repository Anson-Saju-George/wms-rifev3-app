# WMS_MODE is the runtime/image mode switch.
# - local-gpu: builds backend-local-gpu, includes CUDA/Torch, downloads RIFE models from Hugging Face at startup.
# - modal: builds backend-modal, stays slim/no CUDA/no Torch/no model folders, skips local model download.
WMS_MODE=local-gpu

# HOST_PORT is the localhost port published by Docker Compose.
# - 8000 -> http://localhost:8000
# - 80   -> http://localhost
# Container internal port is always 8000.
HOST_PORT=8000

# Local job controls.
# MAX_CONCURRENCY starts this many backend worker threads and caps active local inference subprocesses.
MAX_CONCURRENCY=3

# Upload rate limit per authenticated user. Set either value to 0 to disable the in-memory limiter.
RATE_WINDOW_SECONDS=3600
RATE_MAX_REQUESTS=20

# Optional advanced env vars can be added only when needed:
# GOOGLE_CLIENT_ID, JWT_SECRET, RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET,
# MODAL_ENDPOINT_URL, MODAL_TOKEN, BASE_PATH, API_BASE_URL.
# If JWT_SECRET is omitted, the container generates a dev-only ephemeral secret.