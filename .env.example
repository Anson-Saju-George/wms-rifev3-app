# WMS_MODE selects the Docker build target.
# - local-gpu: CUDA/Torch image for local subprocess inference.
# - modal: slim API/static image for Modal-backed inference.
WMS_MODE=local-gpu

# HOST_PORT is the localhost port published by Docker Compose.
# - 8000 -> http://localhost:8000
# - 80   -> http://localhost
# Container internal port is always 8000.
HOST_PORT=80

# Local job controls.
MAX_CONCURRENCY=3
RATE_WINDOW_SECONDS=3600
RATE_MAX_REQUESTS=20

# Upload/API limits. Read by the WMS container at startup.
MAX_FILE_SIZE_MB=100
MAX_VIDEO_SECONDS=300

# Modal function timeout. Read by backend/modal_app.py during modal run/deploy; redeploy after changing.
MODAL_TIMEOUT_SECONDS=3600

# Inference backend switch. Leave blank to use WMS_MODE defaults; set explicitly for deploys.
INFERENCE_BACKEND_MODAL=
FALLBACK_TO_LOCAL=
MODAL_APP_NAME=
MODAL_FUNCTION_NAME=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Optional auth/payment runtime values. Leave blank for local inference-only testing.
GOOGLE_CLIENT_ID=
JWT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=